# Ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_PATH=.chroma

# Twin
TWIN_SEED=42
PREDICT_EVERY_N_TICKS=6
OVERRIDE_WINDOW_S=600

# Safety thresholds
AUTO_CONFIDENCE_THRESHOLD=0.80
MAX_FLOW_REDUCTION_PCT=0.50
MIN_BASELOAD_PCT=0.20
MAX_ACTIONS_PER_10MIN=3
FLUSH_COOLDOWN_MINS=60

# Sediment rating curve (silt_ppm = a * Q^b)
RATING_CURVE_A=0.45
RATING_CURVE_B=1.8

# Severity thresholds (on max-risk from AnomalyVector)
SEVERITY_WATCH=0.35
SEVERITY_WARNING=0.60
SEVERITY_CRITICAL=0.85
